# --- MQTT / Unified Namespace ---
# Laptop: localhost. On the VENTUNO Q under App Lab with the mqtt_broker custom
# brick, set MQTT_HOST=mqtt_broker (the broker's Compose service name).
MQTT_HOST=localhost
MQTT_PORT=1883
UNS_BASE=acme/barcelona/packaging/line1/conveyor01

# --- Simulator ---
SIM_FS=2000
SIM_WINDOW=2000
SIM_RPM=1450
# Mean seconds between injected anomalies (spec: ~300 = every 5 min).
# Lower to ~45 for a fast local demo.
ANOMALY_PERIOD_S=300

# --- Inference ---
# brick (App Lab vibration_anomaly_detection, default) | eim (local .eim) | statistical
MODEL_BACKEND=brick
EIM_PATH=models/conveyor-anomaly.eim
ANOMALY_THRESHOLD=0.5
ANOMALY_PERSIST=3

# --- LLM (agents) ---
# brick (App Lab llm brick, local Gemma/Qwen/Qwen3, default) | ollama (local server)
LLM_BACKEND=brick
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=gemma3:4b
# Dashboard label for the brick path. Leave empty to auto-detect the model the
# App Lab llm brick resolves (e.g. genie:qwen3_4b_instruct_2507); set explicitly
# only to override the label.
LLM_MODEL=

# --- Agents / A2A ---
A2A_HOST=localhost
MAINT_PORT=8001
PLAN_PORT=8002
CORP_PORT=8003
# Repair window length (s). Spec/demo: 60 = machine fixed in ~1 min.
MAINT_DURATION_S=60
# How often each agent posts a "nominal / all clear" heartbeat trace to Panel C
# while the line is healthy (0 disables). Agents stay quiet mid-incident.
HEARTBEAT_S=60

# --- Dashboard ---
DASHBOARD_PORT=5001

# --- Logging ---
# INFO = lifecycle + events. DEBUG = every MQTT publish/receive (topic + bytes)
# and per-window inference detail — use it to trace the vibration pipeline.
LOG_LEVEL=INFO

# --- Edge Impulse ingestion (Panel A record/ingest) ---
# The API key is now entered in the dashboard UI (browser-held) and sent per
# request, so EI_API_KEY here is optional/unused. Only the ingestion URL is read
# server-side.
EI_API_KEY=
EI_INGESTION_URL=https://ingestion.edgeimpulse.com
