# --- MQTT / Unified Namespace ---
MQTT_HOST=localhost
MQTT_PORT=1883
UNS_BASE=acme/barcelona/packaging/line1/conveyor01

# --- Simulator ---
SIM_FS=2000
SIM_WINDOW=2000
SIM_RPM=1450
# Mean seconds between injected anomalies (spec: ~300 = every 5 min).
# Lower to ~45 for a fast local demo.
ANOMALY_PERIOD_S=300

# --- Inference ---
# statistical (laptop) | eim (local .eim) | brick (App Lab vibration_anomaly_detection)
MODEL_BACKEND=statistical
EIM_PATH=models/conveyor-anomaly.eim
ANOMALY_THRESHOLD=0.5
ANOMALY_PERSIST=3

# --- LLM (agents) ---
# mock (laptop) | ollama (local server) | brick (App Lab llm brick, local Gemma/Qwen)
LLM_BACKEND=mock
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=gemma3:4b

# --- Agents / A2A ---
A2A_HOST=localhost
MAINT_PORT=8001
PLAN_PORT=8002
CORP_PORT=8003
MAINT_DURATION_S=90

# --- Dashboard ---
DASHBOARD_PORT=5001

# --- Edge Impulse ingestion (Panel A retraining; keep secret, do NOT commit) ---
EI_API_KEY=
EI_INGESTION_URL=https://ingestion.edgeimpulse.com
